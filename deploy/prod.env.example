# --- Core (required) ---
# host = "db" (the compose service name); password MUST match deploy/db.env
DATABASE_URL=postgresql://genkit_user:CHANGE_ME_strongpw@db:5432/genkit
JWT_SECRET=CHANGE_ME_run_openssl_rand_hex_32
PORT=3001
WASP_WEB_CLIENT_URL=https://scribegem.com
WASP_SERVER_URL=https://api.scribegem.com
ADMIN_EMAILS=Printmanzil@gmail.com

# --- Stripe (active payment processor) ---
STRIPE_API_KEY=sk_live_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
PAYMENTS_HOBBY_SUBSCRIPTION_PLAN_ID=price_CHANGE_ME
PAYMENTS_PRO_SUBSCRIPTION_PLAN_ID=price_CHANGE_ME
PAYMENTS_CREDITS_10_PLAN_ID=price_CHANGE_ME

# --- Email (REQUIRED for prod auth — switch main.wasp Dummy -> SendGrid first) ---
